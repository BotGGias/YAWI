<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Finish page content; message and launch label are bound in FinishPageController. -->
<VBox spacing="12.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.yawi.installer.ui.page.FinishPageController">
   <children>
      <Label fx:id="message" styleClass="page-heading" wrapText="true" />
      <Label fx:id="pathHint" styleClass="page-hint" wrapText="true" />
      <CheckBox fx:id="launch" mnemonicParsing="false">
         <VBox.margin>
            <Insets top="30.0" />
         </VBox.margin>
      </CheckBox>
      <HBox spacing="8.0">
         <children>
            <Button fx:id="openLog" mnemonicParsing="false" onAction="#openLog" text="%finish.openLog" />
            <Button fx:id="saveReport" mnemonicParsing="false" onAction="#saveReport" text="%finish.saveReport" />
            <Button fx:id="saveAnswers" mnemonicParsing="false" onAction="#saveAnswers" text="%finish.saveAnswers" />
         </children>
      </HBox>
      <Label fx:id="reportStatus" styleClass="page-hint" wrapText="true" />
   </children>
</VBox>
