<?xml version="1.0" encoding="UTF-8"?>
<!-- InstallRunner rollback tests: "core" extracts the sample archive, "broken" adds a failing command. -->
<installer schemaVersion="1">
  <product id="rollback" version="2"><name>Rollback</name></product>
  <languages default="en"><language code="en"/></languages>
  <wizard><page name="welcome"/><page name="components"/><page name="summary"/></wizard>
  <destination><default os="linux">$HOME/rollback</default><default os="windows">%LOCALAPPDATA%\rollback</default><default os="macos">$HOME/rollback</default></destination>
  <sources>
    <source id="zip" size="702"><provider type="bundled"><path>classpath:/archives/sample.zip</path></provider></source>
  </sources>
  <components>
    <component id="core" required="true" size="1MiB">
      <name>Core</name>
      <step ref="unzip"/>
    </component>
    <component id="broken" size="1MiB">
      <name>Broken</name>
      <dependsOn ref="core"/>
      <step ref="boom"/>
      <step ref="never"/>
    </component>
  </components>
  <steps>
    <step id="unzip" type="extract"><archive ref="zip"/><to>${destination}</to></step>
    <step id="boom" type="run-command">
      <commands os="linux"><command><arg>/bin/sh</arg><arg>-c</arg><arg>echo going wrong; exit 2</arg></command></commands>
      <commands os="macos"><command><arg>/bin/sh</arg><arg>-c</arg><arg>echo going wrong; exit 2</arg></command></commands>
      <commands os="windows"><command><arg>cmd</arg><arg>/c</arg><arg>echo going wrong&amp;&amp; exit 2</arg></command></commands>
    </step>
    <step id="never" type="mkdir"><to>${destination}/never</to></step>
  </steps>
</installer>
