<?xml version="1.0" encoding="UTF-8"?>
<!-- E13-S01: "core" extracts the sample archive and the shortcut points at bin/run.sh; "broken" makes an update fail. -->
<installer schemaVersion="1">
  <product id="shortcuts" version="2"><name>Shortcuts</name><icon>classpath:/img/icon.png</icon></product>
  <languages default="en"><language code="en"/></languages>
  <wizard><page name="welcome"/><page name="components"/><page name="summary"/></wizard>
  <destination><default os="linux">$HOME/shortcuts</default><default os="windows">%LOCALAPPDATA%\shortcuts</default><default os="macos">$HOME/shortcuts</default></destination>
  <sources>
    <source id="zip" size="702"><provider type="bundled"><path>classpath:/archives/sample.zip</path></provider></source>
  </sources>
  <components>
    <component id="core" required="true" size="1MiB">
      <name>Core</name>
      <step ref="unzip"/>
    </component>
    <component id="broken" size="1MiB">
      <name>Broken</name>
      <dependsOn ref="core"/>
      <step ref="boom"/>
    </component>
  </components>
  <steps>
    <step id="unzip" type="extract"><archive ref="zip"/><to>${destination}</to></step>
    <step id="boom" type="run-command">
      <commands os="linux"><command><arg>/bin/sh</arg><arg>-c</arg><arg>exit 2</arg></command></commands>
      <commands os="macos"><command><arg>/bin/sh</arg><arg>-c</arg><arg>exit 2</arg></command></commands>
      <commands os="windows"><command><arg>cmd</arg><arg>/c</arg><arg>exit 2</arg></command></commands>
    </step>
  </steps>
  <integration>
    <shortcut id="run" desktop="true" menu="true">
      <name>Sample Run</name>
      <target>${destination}/bin/run.sh</target>
    </shortcut>
    <shortcut id="menu-only" desktop="false" menu="true">
      <name>Sample Readme</name>
      <target>${destination}/README.txt</target>
      <icon>${destination}/README.txt</icon>
    </shortcut>
  </integration>
</installer>
