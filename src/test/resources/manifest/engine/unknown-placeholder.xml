<?xml version="1.0" encoding="UTF-8"?>
<!-- Engine tests: placeholders the plan must reject; the Windows-only ${BAD} is not checked on Linux. -->
<installer schemaVersion="1">
  <product id="unk" version="1"><name>Unknown</name></product>
  <languages default="en"><language code="en"/></languages>
  <wizard><page name="welcome"/><page name="components"/><page name="summary"/></wizard>
  <destination><default os="linux">$HOME/unk</default><default os="windows">%LOCALAPPDATA%\unk</default><default os="macos">$HOME/unk</default></destination>
  <components>
    <component id="core" required="true" size="1MiB">
      <name>Core</name>
      <step ref="bad-template"/>
      <step ref="bad-command"/>
    </component>
  </components>
  <steps>
    <step id="bad-template" type="template">
      <from>classpath:/templates/x.ini</from>
      <to>${destination}/x.ini</to>
      <replace key="A" value="${input.nope}"/>
    </step>
    <step id="bad-command" type="run-command">
      <commands os="linux"><command><arg>echo</arg><arg>${HOME}</arg></command></commands>
      <commands os="windows"><command><arg>echo</arg><arg>${BAD}</arg></command></commands>
    </step>
  </steps>
</installer>
