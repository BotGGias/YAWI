<?xml version="1.0" encoding="UTF-8"?>
<installer schemaVersion="1">
  <product id="p" version="1"><name>P</name></product>
  <languages default="en"><language code="en"/></languages>
  <wizard><page name="welcome"/></wizard>
  <destination><default os="linux">$HOME/p</default></destination>
  <components>
    <component id="core" required="true">
      <name>Core</name>
      <input id="mode" type="choice" default="wan"><label>Mode</label><option value="lan">LAN</option></input>
    </component>
  </components>
</installer>
