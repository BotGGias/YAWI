<?xml version="1.0" encoding="UTF-8"?>
<installer schemaVersion="1">
  <product id="p" version="1"><name>P</name></product>
  <languages default="en"><language code="en"/></languages>
  <wizard><page name="welcome"/></wizard>
  <destination><default os="linux">$HOME/p</default></destination>
  <sources>
    <source id="data"><provider type="bundled"><path>classpath:/x.zip</path></provider></source>
  </sources>
  <components>
    <component id="core" required="true"><name>Core</name><step ref="unpack"/></component>
  </components>
  <steps>
    <step id="unpack" type="extract"><to>${destination}</to></step>
    <step id="run" type="run-command"/>
    <step id="mk" type="mkdir"/>
    <step id="mode" type="chmod"><to>${destination}/x</to></step>
  </steps>
</installer>
